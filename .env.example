NODE_ENV=development
PORT=3002
BASE_URL=http://localhost:3002
# Required for upload and delete routes. Generate with: openssl rand -hex 32
API_KEY=replace-with-a-long-random-secret
# Comma-separated browser origins, e.g. https://tc-newgen-chat.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://tc-newgen-chat.vercel.app
MAX_FILE_SIZE_MB=250
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
TRUST_PROXY=0
